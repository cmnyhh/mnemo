# 推荐：./scripts/setup-env.sh —— 自动填好下列三个凭据，并把登录账号打在屏幕上。
# 也可以手工：cp .env.example .env && chmod 600 .env，再自己填
# （随机值：openssl rand -base64 24）。
#
# .env 里有密码，不要提交到 git。

# --- 必填 ---
POSTGRES_PASSWORD=
QDRANT_API_KEY=

# --- 租户 ---
# 一个部署一个租户。令牌签发时绑定它，请求方不能自己指定。
MEMORY_TENANT=default

# --- 控制台 ---
# http://<主机>:8090/ 的登录账号与口令，与 API 令牌互不影响。
# 口令留空 = 控制台关闭，记忆 API 照常工作。
# 两者只在首次启动时写库；之后在「系统」页改，改 .env 不会再覆盖。
# 生成口令：openssl rand -base64 18
MEMORY_ADMIN_USERNAME=admin
MEMORY_ADMIN_PASSWORD=
MEMORY_ADMIN_SESSION_HOURS=12
# auto = 按请求判断（含 X-Forwarded-Proto）；走 HTTPS 反代也可以直接写 true
MEMORY_ADMIN_COOKIE_SECURE=auto

# --- 嵌入模型 ---
# hash = 本地确定性向量，只够把链路跑通；要语义召回必须改成 http
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding-8b
# 必须等于模型原生维度（Qwen3-Embedding-8B 是 4096）。建集合前定死，改了要全量重算。
EMBEDDING_DIMS=4096

# --- 精排（可选）---
# none = 按 RRF 名次；http = 调 {BASE_URL}/rerank
# 只影响排序精度，不影响能否召回。
RERANK_PROVIDER=none
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=
# 硬预算，超时退回 RRF 顺序
RERANK_TIMEOUT_MS=600
# 只精排融合后的前 N 条
RERANK_TOP_N=12
# 第一名领先第二名超过此值就跳过精排（0 = 从不跳过）
RERANK_SKIP_GAP=0.35

# --- 写入抽取（决定「记什么」，是召回质量的上限）---
# none = 按段硬切；http = 调 {BASE_URL}/chat/completions 做结构化抽取
# 产出 narrative / facts / entities / recall_hints / confidence，hints 进 BM25 与向量
EXTRACT_PROVIDER=none
EXTRACT_API_KEY=
EXTRACT_BASE_URL=
EXTRACT_MODEL=
# 抽取在写路径上同步等待；换大模型要调大，或改成异步写入
EXTRACT_TIMEOUT_MS=20000
# 单次最多几条，低置信度的由 min-confidence 过滤
EXTRACT_MAX_ITEMS=8
EXTRACT_MIN_CONFIDENCE=0.35

# --- 召回 ---
# 向量相似度低于此值不进融合。设太松会让噪声拿到满分名次（RRF 只看名次），
# 设太紧向量这一路永不投票。换模型要重新标定。
DENSE_MIN_SCORE=0.25

# --- 服务 ---
# 对外端口。前面没有 HTTPS 反代时改成 127.0.0.1:8090
MNEMO_PORT=8090

# --- 构建（从源码构建时用，生产建议钉 tag）---
PG_TEXTSEARCH_REF=main
